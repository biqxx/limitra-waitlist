[Unit]
Description=Renew Limitra TLS certificates
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/platform
ExecStart=/usr/bin/docker compose --profile tools run --rm certbot renew --webroot --webroot-path /var/www/certbot --quiet
ExecStartPost=/usr/bin/docker compose exec -T nginx nginx -s reload
